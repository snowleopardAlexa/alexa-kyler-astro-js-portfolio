---
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = "" } = Astro.props;
---

<div
  class={`flex flex-col items-center justify-center gap-1 border border-dashed border-border bg-muted/40 text-center ${className}`}
>
  <span class="text-sm font-medium text-muted-foreground">{label}</span>
  <span class="text-xs text-muted-foreground/70">Visual pending</span>
</div>
