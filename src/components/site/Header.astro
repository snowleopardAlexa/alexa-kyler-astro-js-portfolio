---
import { SITE } from "@/data/site";

// Work dropdown items, in display order.
const WORK_MENU = [
  {
    title: "Wildari Planet",
    description: "Full-stack conservation platform built with Drupal 10, Astro.js, and Claude Code.",
    href: "/work/wildari-planet",
  },
  {
    title: "Cat Connections NYC",
    description: "Full CMS website, Shelterluv forms, Google Workspace, social media, and branding.",
    href: "/work/cat-connections-nyc-technical-lead",
  },
  {
    title: "Cat Connections NYC",
    description: "Raisely eCRM, Donation Forms, GoFundMe, and Zeffy campaigns that raised $18,000+.",
    href: "/work/cat-connections-nyc-digital-fundraising",
  },
  {
    title: "Sisters of St. Joseph",
    description: "Three-site WordPress rebuild with Blackbaud Raiser's Edge CRM integration.",
    href: "/work/sisters-of-st-joseph",
  },
];
// Each menu arrow starts pointing a different way (degrees, 0 = right).
const ARROW_ANGLES = [-45, 45, 135, -135];
---

<header class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6">
    <a href="/" class="text-base font-semibold tracking-tight text-foreground shrink-0">
      {SITE.wordmark}
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1 mx-auto">
      <details class="group relative">
        <summary class="cursor-pointer list-none select-none flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-foreground/80 hover:text-foreground transition-colors">
          Work
          <svg viewBox="0 0 12 12" class="size-3 transition-transform group-open:rotate-180" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="mega-panel invisible absolute left-1/2 top-full z-50 mt-2 w-[min(90vw,640px)] -translate-x-1/2 rounded-xl border border-border bg-background opacity-0 shadow-xl transition-all duration-150 group-open:visible group-open:opacity-100 md:group-hover:visible md:group-hover:opacity-100">
          <div class="grid grid-cols-2 gap-1 p-3">
            {WORK_MENU.map((item, i) => (
              <a
                href={item.href}
                class="menu-item flex items-center gap-3 rounded-lg p-2 hover:bg-muted transition-colors"
              >
                <span class="flex size-12 shrink-0 items-center justify-center rounded-md border border-border bg-white">
                  <svg
                    viewBox="0 0 24 24"
                    class="menu-arrow size-5 text-black"
                    style={`--angle: ${ARROW_ANGLES[i % ARROW_ANGLES.length]}deg`}
                    fill="none"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="min-w-0">
                  <span class="block truncate text-sm font-medium text-foreground">{item.title}</span>
                  <span class="block truncate text-xs text-muted-foreground">{item.description}</span>
                </span>
              </a>
            ))}
          </div>
          <div class="border-t border-border p-3">
            <a href="/work" class="text-sm font-medium text-foreground hover:underline underline-offset-4">
              View all work &rarr;
            </a>
          </div>
        </div>
      </details>

      {SITE.nav.slice(1).map((item) => (
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          class="rounded-md px-3 py-2 text-sm font-medium text-foreground/80 hover:text-foreground transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <!-- Dark/light switcher (based on the starter template's ModeToggle) -->
      <button
        type="button"
        data-theme-toggle
        class="flex size-9 items-center justify-center rounded-md border border-border text-foreground/80 hover:text-foreground hover:bg-muted transition-colors"
        aria-label="Switch between dark and light mode"
      >
        <!-- Sun shows in dark mode (switch to light), moon in light mode -->
        <svg viewBox="0 0 24 24" class="hidden size-4 dark:block" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        <svg viewBox="0 0 24 24" class="block size-4 dark:hidden" fill="none" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        </svg>
      </button>

      <!-- Mobile menu -->
      <details class="md:hidden relative">
        <summary class="cursor-pointer list-none flex size-9 items-center justify-center rounded-md border border-border">
          <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="sr-only">Menu</span>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 w-72 rounded-xl border border-border bg-background p-4 shadow-xl">
          <p class="mb-2 text-xs font-medium uppercase tracking-wide text-muted-foreground">Work</p>
          <div class="mb-4 flex flex-col gap-1">
            {WORK_MENU.map((item) => (
              <a href={item.href} class="rounded-md px-2 py-1.5 text-sm text-foreground hover:bg-muted">
                {item.title}
              </a>
            ))}
            <a href="/work" class="rounded-md px-2 py-1.5 text-sm font-medium text-foreground hover:bg-muted">
              View all work &rarr;
            </a>
          </div>
          <div class="flex flex-col gap-1 border-t border-border pt-3">
            {SITE.nav.slice(1).map((item) => (
              <a
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="rounded-md px-2 py-1.5 text-sm text-foreground hover:bg-muted"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
    button.addEventListener("click", () => {
      const root = document.documentElement;
      const isDark = root.classList.toggle("dark");
      root.style.colorScheme = isDark ? "dark" : "light";
      try {
        localStorage.setItem("color-theme", isDark ? "dark" : "light");
      } catch (_) {}
    });
  });
</script>

<style>
  summary::-webkit-details-marker {
    display: none;
  }

  /* Work menu arrows: each rests at its own angle and spins continuously
     while its item is hovered or focused. */
  .menu-arrow {
    transform: rotate(var(--angle));
  }
  .menu-item:hover .menu-arrow,
  .menu-item:focus-visible .menu-arrow {
    animation: menu-arrow-spin 0.9s linear infinite;
  }
  @keyframes menu-arrow-spin {
    from {
      transform: rotate(var(--angle));
    }
    to {
      transform: rotate(calc(var(--angle) + 360deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-item:hover .menu-arrow,
    .menu-item:focus-visible .menu-arrow {
      animation: none;
    }
  }
</style>

<script>
  // Close any open <details> mega/mobile menus on outside click or Escape.
  // No framework needed for this -- kept as a tiny vanilla listener.
  document.addEventListener("click", (e) => {
    document.querySelectorAll("header details[open]").forEach((el) => {
      if (!(el as HTMLElement).contains(e.target as Node)) {
        el.removeAttribute("open");
      }
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document.querySelectorAll("header details[open]").forEach((el) => el.removeAttribute("open"));
    }
  });
</script>
