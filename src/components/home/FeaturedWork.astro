---
import CaseStudyCard from "@/components/work/CaseStudyCard.astro";
import { FEATURED_CARDS } from "@/data/featured";
---

<section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
  <div class="mb-10 flex items-end justify-between gap-4">
    <h2 class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl">Featured work</h2>
    <a href="/work" class="hidden shrink-0 text-sm font-medium text-foreground hover:underline underline-offset-4 sm:inline">
      View all work &rarr;
    </a>
  </div>

  <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2">
    {FEATURED_CARDS.map((card) => (
      <CaseStudyCard
        slug={card.slug}
        href={card.href}
        title={card.title}
        tagline={card.description}
        tags={card.tags}
        thumbnail={card.thumbnail}
        thumbnailVideo={card.thumbnailVideo}
        mediaContain={card.mediaContain}
        large
        tilt
      />
    ))}
  </div>

  <a href="/work" class="mt-8 inline-flex text-sm font-medium text-foreground hover:underline underline-offset-4 sm:hidden">
    View all work &rarr;
  </a>
</section>
