---
// Draft, but every line is a real fact pulled from resume.tsx (no invented numbers).
const facts = [
  "$18k raised in about six months",
  "Full-stack platform built solo",
  "3 nonprofit program sites redesigned",
  "Solo web lead for 4 nonprofits",
];
---

<section class="border-y border-border">
  <div class="mx-auto max-w-6xl px-6 py-6">
    <ul class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between sm:gap-6">
      {facts.map((fact) => (
        <li class="text-sm font-medium text-foreground sm:text-base">{fact}</li>
      ))}
    </ul>
  </div>
</section>
