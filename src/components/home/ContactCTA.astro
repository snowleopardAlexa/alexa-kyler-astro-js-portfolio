---
import { SITE } from "@/data/site";
---

<section class="border-t border-border">
  <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-5 text-center">
      <span class="text-xs font-medium uppercase tracking-widest text-muted-foreground">Let's work together</span>
      <p class="text-xl text-foreground sm:text-2xl">
        Need a website, donation form, or eCRM setup for your nonprofit? I'd love to hear about it.
      </p>
      <a
        href={`mailto:${SITE.footer.email}`}
        class="inline-flex items-center rounded-md bg-foreground px-5 py-2.5 text-sm font-medium text-background hover:opacity-90 transition-opacity"
      >
        Contact me
      </a>
    </div>
  </div>
</section>
