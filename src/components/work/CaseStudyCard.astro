---
import WorkMedia from "@/components/work/WorkMedia.astro";
import BrowserFrame from "@/components/BrowserFrame.astro";

interface Props {
  slug: string;
  href?: string; // defaults to the /work/<slug> case study
  title: string;
  tagline: string;
  thumbnail?: string;
  thumbnailVideo?: string;
  large?: boolean;
  tilt?: boolean;
  mediaContain?: boolean;
  tags?: string[];
  ctaLabel?: string; // button-style label under the tags
  external?: boolean; // open href in a new tab
}
const {
  slug,
  href = `/work/${slug}`,
  title,
  tagline,
  tags = [],
  thumbnail,
  thumbnailVideo,
  large = false,
  tilt = false,
  mediaContain = false,
  ctaLabel,
  external = false,
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class="group flex flex-col gap-4"
>
  <BrowserFrame tilt={tilt} class={`w-full ${large ? "aspect-[16/10]" : "aspect-[4/3]"}`}>
    <WorkMedia
      title={title}
      thumbnail={thumbnail}
      thumbnailVideo={thumbnailVideo}
      contain={mediaContain}
      class="size-full transition-transform duration-300 group-hover:scale-[1.02]"
    />
  </BrowserFrame>
  <div class="flex flex-col gap-1">
    <span class={`font-semibold text-foreground ${large ? "text-xl" : "text-lg sm:text-xl"}`}>{title}</span>
    <span class="text-sm text-muted-foreground">{tagline}</span>
    {tags.length > 0 && (
      <ul class="mt-2 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded-full border border-border bg-muted px-2.5 py-0.5 text-xs text-foreground/80">{tag}</li>
        ))}
      </ul>
    )}
    {ctaLabel && (
      <span class="mt-4 inline-flex w-fit items-center gap-1.5 rounded-md bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity group-hover:opacity-90">
        {ctaLabel} &rarr;
      </span>
    )}
  </div>
</a>
