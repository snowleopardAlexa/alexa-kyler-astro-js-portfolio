---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { TOOLS, TOOL_GROUPS } from "@/data/tools";
---

<Layout title="Tools" description="What I actually did with each tool, on real projects.">
  <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
    <h1 class="text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">Tools</h1>
    <p class="mt-3 max-w-xl text-muted-foreground">
      What I actually did with each tool on a real project. I focus on using each tool to solve
      specific problems efficiently, adapting quickly to whatever the project demands.
    </p>

    {TOOL_GROUPS.map((group) => (
      <div class="mt-12">
        <h2 class="text-xs font-medium uppercase tracking-widest text-muted-foreground">{group}</h2>
        <div class="mt-4 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-2">
          {TOOLS.filter((tool) => tool.group === group).map((tool) => (
            <div class="flex gap-4 bg-background p-5">
              <span class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-border">
                <tool.logo className="size-5" />
              </span>
              <div class="min-w-0">
                <span class="font-medium text-foreground">{tool.name}</span>
                <p class="mt-1 text-sm text-muted-foreground">{tool.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
</Layout>
